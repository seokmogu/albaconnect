# AlbaConnect internal-network POC environment.
# Copy to .env.poc and replace host URLs with the Mac mini's LAN hostname or IP.

# Public URLs used by browsers on the company network.
# Do not leave these as localhost when other machines will access the POC.
POC_WEB_PUBLIC_URL=http://macmini.local:3000
POC_API_PUBLIC_URL=http://macmini.local:3001

# Host ports exposed on the Mac mini.
# Web/API bind to the LAN; Postgres/Redis bind to localhost by default.
WEB_BIND=0.0.0.0
API_BIND=0.0.0.0
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local database credentials. Keep simple ASCII unless you also URL-encode DATABASE_URL.
POSTGRES_PASSWORD=postgres

# POC secrets. Replace before sharing beyond a closed internal test group.
JWT_SECRET=change-this-poc-jwt-secret-minimum-32-characters
JWT_REFRESH_SECRET=change-this-poc-refresh-secret-min-32-chars
ADMIN_TOKEN=change-this-poc-admin-token

# Internal POC defaults to mock Toss, so no public Toss webhook URL is required.
TOSS_CLIENT_MODE=mock
TOSS_ALLOW_MOCK_CLIENT=true
TOSS_ALLOW_TEST_KEYS=true
TOSS_SECRET_KEY=test_sk_poc_mock
TOSS_CLIENT_KEY=test_ck_poc_mock
TOSS_WEBHOOK_SECRET=poc-webhook-secret
TOSS_MOCK_PAYMENT_STATUS=DONE
TOSS_MOCK_TOTAL_AMOUNT=55000
PAYOUT_RELEASE_MODE=manual

# Optional external integrations. Leave blank for internal POC fallback behavior.
KAKAO_BIZ_API_KEY=
KAKAO_SENDER_KEY=
NEXT_PUBLIC_KAKAO_MAP_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
