# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/albaconnect
# JWT
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-too-different-from-jwt-secret-min-32-chars
# Redis (optional — omit to use in-memory fallback cache)
# REDIS_URL=redis://localhost:6379
# Server
PORT=3001
NODE_ENV=development
WEB_URL=http://localhost:3000
ADMIN_TOKEN=change-this-admin-token
# Next.js (web)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_KAKAO_MAP_API_KEY=your-kakao-map-api-key
# Toss Payments (https://developers.tosspayments.com/)
TOSS_SECRET_KEY=test_sk_...          # Server-side secret key (omit for dev/stub mode)
TOSS_CLIENT_KEY=test_ck_...          # Client-side publishable key (for frontend widget)
TOSS_WEBHOOK_SECRET=your-webhook-secret  # Webhook signing secret (omit to skip validation)
TOSS_CLIENT_MODE=rest                # rest | mock | mcp-mock
# TOSS_ALLOW_TEST_KEYS=true          # Staging only: allow test_sk/test_gsk with production readiness check
# TOSS_MOCK_PAYMENT_STATUS=DONE      # mock/mcp-mock only
# TOSS_MOCK_ORDER_ID=mock_order_123  # mock/mcp-mock only
# TOSS_MOCK_TOTAL_AMOUNT=55000       # mock/mcp-mock only
# TOSS_SMOKE_PAYMENT_KEY=pay_...     # Optional: payment lookup smoke test input
# Payout release mode: production requires manual or external before escrow can be marked released.
PAYOUT_RELEASE_MODE=stub
# KakaoTalk Alim Talk (https://center-pf.kakao.com)
# Register templates JOB_AVAILABLE, JOB_CONFIRMED, PAYMENT_COMPLETE before production use.
# Leave unset for dev-stub mode (logs intent without calling Kakao API).
# KAKAO_BIZ_API_KEY=your-kakao-biz-api-key
# KAKAO_SENDER_KEY=your-plusfriend-sender-key
