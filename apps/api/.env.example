DATABASE_URL=postgresql://postgres:postgres@localhost:5432/albaconnect
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
WEB_URL=http://localhost:3000
ADMIN_TOKEN=change-this-admin-token
# KakaoTalk Alim Talk (register templates at https://center-pf.kakao.com before use)
KAKAO_BIZ_API_KEY=<from kakao biz center>
KAKAO_SENDER_KEY=<plusfriend sender key>
TOSS_CLIENT_KEY=test_ck_your_toss_client_key
TOSS_SECRET_KEY=test_sk_your_toss_secret_key
TOSS_WEBHOOK_SECRET=your-webhook-secret
TOSS_ALLOW_TEST_KEYS=true
TOSS_CLIENT_MODE=rest
# TOSS_CLIENT_MODE=mock 또는 mcp-mock이면 Toss API 네트워크 호출 없이 결제 조회를 흉내냅니다.
# TOSS_MOCK_PAYMENT_STATUS=DONE
# TOSS_MOCK_ORDER_ID=mock_order_123
# TOSS_MOCK_TOTAL_AMOUNT=55000
# TOSS_SMOKE_PAYMENT_KEY=pay_...
PAYOUT_RELEASE_MODE=stub
PORT=3001
NODE_ENV=development

# Web Push (VAPID) — required for PWA background notifications
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BG...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:admin@yourdomain.com

# Sentry — Error tracking & performance monitoring
# Leave unset in development; set in staging/production
# Get DSN from https://sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
