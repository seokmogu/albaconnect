{
  "name": "@albaconnect/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --workspace-root run wxpr:build && next dev -H 0.0.0.0 -p 3000",
    "build": "pnpm --workspace-root run wxpr:build && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "pnpm --workspace-root run wxpr:build && tsc --noEmit",
    "test": "pnpm --workspace-root run wxpr:build && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@albaconnect/shared": "workspace:*",
    "@hookform/resolvers": "^3.10.0",
    "@sentry/nextjs": "^8.0.0",
    "@wxpr/icons": "workspace:*",
    "@wxpr/react": "workspace:*",
    "@wxpr/tokens": "workspace:*",
    "axios": "^1.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^15.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
